    "deploy:preview": "npx vercel deploy --yes",
    "deploy:prod": "npx vercel deploy --prod --yes"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "next": "16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
