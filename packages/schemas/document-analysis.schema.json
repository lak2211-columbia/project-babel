{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-babel.com/schemas/document-analysis.schema.json",
  "title": "Project Babel Document Analysis",
  "description": "Structured policy extraction and eight-frame risk-framing analysis produced for an individual government document under data/analysis/<jurisdiction>/<document_id>/document_analysis.json (Taxonomy v2.1.0). New v2 analyses with analysis_metadata strictly enforce >=1 evidence span per extracted requirement, enforcement mechanism, and framing analysis while preserving backwards-compatible validation for legacy April 2026 artifacts lacking analysis_metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "language",
    "policy_extraction",
    "risk_framing"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "policy_extraction": {
      "$ref": "#/$defs/policyExtraction"
    },
    "risk_framing": {
      "$ref": "#/$defs/riskFramingAnalysis"
    },
    "analysis_metadata": {
      "anyOf": [
        { "$ref": "#/$defs/analysisProvenance" },
        { "type": "null" }
      ]
    }
  },
  "if": {
    "required": ["analysis_metadata"],
    "properties": {
      "analysis_metadata": { "type": "object" }
    }
  },
  "then": {
    "properties": {
      "policy_extraction": {
        "properties": {
          "safety_requirements": {
            "items": {
              "required": ["evidence"],
              "properties": {
                "evidence": { "minItems": 1 }
              }
            }
          },
          "enforcement_mechanisms": {
            "items": {
              "required": ["evidence"],
              "properties": {
                "evidence": { "minItems": 1 }
              }
            }
          }
        }
      },
      "risk_framing": {
        "properties": {
          "evidence_spans": { "minItems": 1 }
        }
      }
    }
  },
  "$defs": {
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "partialOrFullDate": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "united_states",
        "european_union",
        "south_korea",
        "japan",
        "china"
      ]
    },
    "documentType": {
      "type": "string",
      "enum": [
        "legislation",
        "executive_order",
        "regulatory_guidance",
        "strategy_paper",
        "standards_guideline",
        "voluntary_commitment"
      ]
    },
    "bindingStrength": {
      "type": "string",
      "enum": [
        "binding_law",
        "executive_action",
        "regulatory_guidance",
        "standards_guideline",
        "voluntary_commitment",
        "strategy_statement"
      ]
    },
    "obligationStrength": {
      "type": "string",
      "enum": [
        "mandatory",
        "conditional",
        "recommended",
        "aspirational"
      ]
    },
    "policyRequirementLabel": {
      "type": "string",
      "enum": [
        "risk_assessment",
        "pre_deployment_testing",
        "red_teaming",
        "incident_reporting",
        "transparency_disclosure",
        "model_documentation",
        "third_party_audit",
        "access_controls",
        "compute_governance",
        "content_provenance",
        "human_oversight",
        "registration_licensing",
        "agentic_autonomy_controls",
        "training_data_governance",
        "frontier_safety_evaluation",
        "open_weight_obligations",
        "domestic_representative"
      ]
    },
    "enforcementMechanismLabel": {
      "type": "string",
      "enum": [
        "civil_penalty",
        "criminal_penalty",
        "market_access_restriction",
        "procurement_condition",
        "licensing_requirement",
        "regulatory_supervision",
        "reporting_obligation",
        "soft_enforcement",
        "none_specified"
      ]
    },
    "applicationDomainLabel": {
      "type": "string",
      "enum": [
        "general_purpose_models",
        "critical_infrastructure",
        "biometrics",
        "public_sector_use",
        "employment",
        "education",
        "healthcare",
        "finance",
        "law_enforcement",
        "defense"
      ]
    },
    "riskFramingLabel": {
      "type": "string",
      "enum": [
        "existential_catastrophic",
        "national_security",
        "economic_competitiveness",
        "fundamental_rights",
        "social_stability",
        "innovation_enablement",
        "consumer_public_safety",
        "labor_transition"
      ]
    },
    "frameScoreMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existential_catastrophic": { "$ref": "#/$defs/confidence" },
        "national_security": { "$ref": "#/$defs/confidence" },
        "economic_competitiveness": { "$ref": "#/$defs/confidence" },
        "fundamental_rights": { "$ref": "#/$defs/confidence" },
        "social_stability": { "$ref": "#/$defs/confidence" },
        "innovation_enablement": { "$ref": "#/$defs/confidence" },
        "consumer_public_safety": { "$ref": "#/$defs/confidence" },
        "labor_transition": { "$ref": "#/$defs/confidence" }
      }
    },
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quote"],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1,
          "description": "Verbatim quote grounded in the source document's original language."
        },
        "source_section": {
          "type": ["string", "null"]
        },
        "quote_en": {
          "type": ["string", "null"],
          "description": "Optional English gloss for non-English original-language quotes."
        },
        "frame": {
          "anyOf": [
            { "$ref": "#/$defs/riskFramingLabel" },
            { "type": "null" }
          ],
          "description": "Optional framing label justified by this evidence span."
        },
        "grounding_status": {
          "type": ["string", "null"],
          "enum": ["verbatim", "approximate", "not_found", null],
          "description": "Persisted grounding match status computed against normalized.json."
        },
        "start_char": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "Start character offset in normalized.json plain_text when grounded."
        },
        "end_char": {
          "type": ["integer", "null"],
          "minimum": 0,
          "description": "End character offset in normalized.json plain_text when grounded."
        }
      }
    },
    "safetyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": { "$ref": "#/$defs/policyRequirementLabel" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "obligation_strength": {
          "anyOf": [
            { "$ref": "#/$defs/obligationStrength" },
            { "type": "null" }
          ]
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceSpan" }
        }
      }
    },
    "enforcementMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "confidence"],
      "properties": {
        "label": { "$ref": "#/$defs/enforcementMechanismLabel" },
        "confidence": { "$ref": "#/$defs/confidence" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceSpan" }
        }
      }
    },
    "policyExtraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "issuing_body",
        "document_type",
        "binding_strength",
        "confidence"
      ],
      "properties": {
        "jurisdiction": { "$ref": "#/$defs/jurisdiction" },
        "issuing_body": { "type": "string", "minLength": 1 },
        "document_type": { "$ref": "#/$defs/documentType" },
        "binding_strength": { "$ref": "#/$defs/bindingStrength" },
        "publication_date": { "$ref": "#/$defs/partialOrFullDate" },
        "effective_date": { "$ref": "#/$defs/partialOrFullDate" },
        "covered_actors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "covered_application_domains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/applicationDomainLabel" }
        },
        "prohibited_practices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safety_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/safetyRequirement" }
        },
        "enforcement_mechanisms": {
          "type": "array",
          "items": { "$ref": "#/$defs/enforcementMechanism" }
        },
        "enforcement_authorities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "compliance_deadlines": {
          "type": "array",
          "items": { "type": "string" }
        },
        "penalties_summary": { "type": ["string", "null"] },
        "implementation_notes": { "type": ["string", "null"] },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "riskFramingAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dominant_frame",
        "secondary_frames",
        "frame_confidence",
        "rationale_summary",
        "evidence_spans"
      ],
      "properties": {
        "dominant_frame": { "$ref": "#/$defs/riskFramingLabel" },
        "secondary_frames": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/riskFramingLabel" }
        },
        "frame_confidence": { "$ref": "#/$defs/frameScoreMap" },
        "frame_share": {
          "anyOf": [
            { "$ref": "#/$defs/frameScoreMap" },
            { "type": "null" }
          ],
          "description": "Optional explicit per-document frame allocation summing to ~1.0 across the 8 risk frames."
        },
        "rationale_summary": { "type": "string", "minLength": 1 },
        "evidence_spans": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceSpan" }
        }
      }
    },
    "analysisProvenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Machine-execution provenance persisted on DocumentAnalysis.analysis_metadata (mirrors observatory.models.AnalysisProvenance) for deterministic skip checks and idempotent DB replay.",
      "required": [
        "provider",
        "model",
        "analysis_version",
        "taxonomy_version",
        "taxonomy_hash",
        "extraction_prompt_hash",
        "framing_prompt_hash",
        "input_sha256"
      ],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": ["string", "null"] },
        "temperature": { "type": ["number", "null"], "minimum": 0.0, "maximum": 2.0 },
        "analyzed_at": { "type": ["string", "null"], "format": "date-time" },
        "analysis_version": { "type": "string", "minLength": 1 },
        "taxonomy_version": { "type": "string", "minLength": 1 },
        "taxonomy_hash": { "type": "string", "minLength": 1 },
        "extraction_prompt_hash": { "type": "string", "minLength": 1 },
        "framing_prompt_hash": { "type": "string", "minLength": 1 },
        "input_sha256": { "type": "string", "minLength": 1 },
        "chunked": { "type": "boolean", "default": false },
        "chunk_count": { "type": "integer", "minimum": 1, "default": 1 },
        "usage": {
          "type": "object",
          "additionalProperties": true
        },
        "grounding_summary": {
          "type": ["object", "null"],
          "additionalProperties": true
        }
      }
    }
  }
}
