{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test src/lib/__tests__/*.test.ts",
    "vercel:pull:preview": "npx vercel env pull .vercel/.env.preview.local --environment=preview --yes",
