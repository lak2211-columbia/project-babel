{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-babel.com/schemas/evolution-api.schema.json",
  "title": "Project Babel Longitudinal Regime Evolution API Response",
  "description": "JSON response contract returned by GET /api/evolution?states=0|1 exposing annual AI governance trajectories (2019-2026), supersedes_id amendment diffs, and per-jurisdiction freshness rows (Taxonomy v2.1.0).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "includeSubnational",
    "subnationalCount",
    "years",
    "globalSeries",
    "seriesByJurisdiction",
    "supersessionDiffs",
    "freshnessByJurisdiction"
  ],
  "properties": {
    "includeSubnational": { "type": "boolean" },
    "subnationalCount": { "type": "integer", "minimum": 0 },
    "years": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1990 }
    },
    "globalSeries": {
      "type": "array",
      "items": { "$ref": "#/$defs/evolutionYearPoint" }
    },
    "seriesByJurisdiction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "united_states",
        "european_union",
        "south_korea",
        "japan",
        "china"
      ],
      "properties": {
        "united_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/evolutionYearPoint" }
        },
        "european_union": {
          "type": "array",
          "items": { "$ref": "#/$defs/evolutionYearPoint" }
        },
        "south_korea": {
          "type": "array",
          "items": { "$ref": "#/$defs/evolutionYearPoint" }
        },
        "japan": {
          "type": "array",
          "items": { "$ref": "#/$defs/evolutionYearPoint" }
        },
        "china": {
          "type": "array",
          "items": { "$ref": "#/$defs/evolutionYearPoint" }
        }
      }
    },
    "supersessionDiffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/supersessionDiff" }
    },
    "freshnessByJurisdiction": {
      "type": "array",
      "items": { "$ref": "#/$defs/jurisdictionFreshnessRow" }
    }
  },
  "$defs": {
    "jurisdictionKey": {
      "type": "string",
      "enum": [
        "united_states",
        "european_union",
        "south_korea",
        "japan",
        "china"
      ]
    },
    "frameLabel": {
      "type": "string",
      "enum": [
        "existential_catastrophic",
        "national_security",
        "fundamental_rights",
        "economic_competitiveness",
        "innovation_enablement",
        "social_stability",
        "consumer_public_safety",
        "labor_transition"
      ]
    },
    "keyLabelPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "evolutionYearPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year",
        "newDocuments",
        "cumulativeDocuments",
        "activeDocuments",
        "cumulativeRequirementBreadth",
        "bindingLawCount",
        "bindingLawShare",
        "dominantFrame",
        "frameShares"
      ],
      "properties": {
        "year": { "type": "integer", "minimum": 1990 },
        "newDocuments": { "type": "integer", "minimum": 0 },
        "cumulativeDocuments": { "type": "integer", "minimum": 0 },
        "activeDocuments": { "type": "integer", "minimum": 0 },
        "cumulativeRequirementBreadth": { "type": "integer", "minimum": 0 },
        "bindingLawCount": { "type": "integer", "minimum": 0 },
        "bindingLawShare": { "type": "number", "minimum": 0, "maximum": 100 },
        "dominantFrame": {
          "anyOf": [{ "$ref": "#/$defs/frameLabel" }, { "type": "null" }]
        },
        "frameShares": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "existential_catastrophic",
            "national_security",
            "fundamental_rights",
            "economic_competitiveness",
            "innovation_enablement",
            "social_stability",
            "consumer_public_safety",
            "labor_transition"
          ],
          "properties": {
            "existential_catastrophic": { "type": "number", "minimum": 0, "maximum": 100 },
            "national_security": { "type": "number", "minimum": 0, "maximum": 100 },
            "fundamental_rights": { "type": "number", "minimum": 0, "maximum": 100 },
            "economic_competitiveness": { "type": "number", "minimum": 0, "maximum": 100 },
            "innovation_enablement": { "type": "number", "minimum": 0, "maximum": 100 },
            "social_stability": { "type": "number", "minimum": 0, "maximum": 100 },
            "consumer_public_safety": { "type": "number", "minimum": 0, "maximum": 100 },
            "labor_transition": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "supersessionDocRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "publicationDate",
        "publicationDateIso",
        "bindingStrength",
        "bindingStrengthLabel",
        "lifecycleStageLabel",
        "languageCode",
        "subnationalUnit"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "publicationDate": { "type": "string" },
        "publicationDateIso": { "type": ["string", "null"] },
        "bindingStrength": { "type": "string", "minLength": 1 },
        "bindingStrengthLabel": { "type": "string", "minLength": 1 },
        "lifecycleStageLabel": { "type": "string", "minLength": 1 },
        "languageCode": { "type": "string", "minLength": 2 },
        "subnationalUnit": { "type": ["string", "null"] }
      }
    },
    "supersessionDiff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "jurisdictionKey",
        "jurisdictionSlug",
        "jurisdictionShort",
        "jurisdictionName",
        "flagUrl",
        "predecessor",
        "successor",
        "addedRequirements",
        "removedRequirements",
        "retainedRequirements",
        "addedEnforcement",
        "removedEnforcement",
        "bindingChange",
        "dominantFrameChange"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "jurisdictionKey": { "$ref": "#/$defs/jurisdictionKey" },
        "jurisdictionSlug": { "type": "string", "minLength": 1 },
        "jurisdictionShort": { "type": "string", "minLength": 2, "maxLength": 4 },
        "jurisdictionName": { "type": "string", "minLength": 1 },
        "flagUrl": { "type": "string", "minLength": 1 },
        "predecessor": { "$ref": "#/$defs/supersessionDocRef" },
        "successor": { "$ref": "#/$defs/supersessionDocRef" },
        "addedRequirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyLabelPair" }
        },
        "removedRequirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyLabelPair" }
        },
        "retainedRequirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyLabelPair" }
        },
        "addedEnforcement": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyLabelPair" }
        },
        "removedEnforcement": {
          "type": "array",
          "items": { "$ref": "#/$defs/keyLabelPair" }
        },
        "bindingChange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "fromLabel", "to", "toLabel", "changed"],
          "properties": {
            "from": { "type": "string", "minLength": 1 },
            "fromLabel": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 },
            "toLabel": { "type": "string", "minLength": 1 },
            "changed": { "type": "boolean" }
          }
        },
        "dominantFrameChange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "fromLabel", "to", "toLabel", "changed"],
          "properties": {
            "from": {
              "anyOf": [{ "$ref": "#/$defs/frameLabel" }, { "type": "null" }]
            },
            "fromLabel": { "type": ["string", "null"] },
            "to": {
              "anyOf": [{ "$ref": "#/$defs/frameLabel" }, { "type": "null" }]
            },
            "toLabel": { "type": ["string", "null"] },
            "changed": { "type": "boolean" }
          }
        }
      }
    },
    "jurisdictionFreshnessRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictionKey",
        "slug",
        "name",
        "shortName",
        "flagUrl",
        "totalDocuments",
        "headlinePrimaryCount",
        "subnationalCount",
        "bindingLawCount",
        "supersessionChainCount",
        "latestPublicationDate",
        "latestPublicationIso"
      ],
      "properties": {
        "jurisdictionKey": { "$ref": "#/$defs/jurisdictionKey" },
        "slug": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "shortName": { "type": "string", "minLength": 2, "maxLength": 4 },
        "flagUrl": { "type": "string", "minLength": 1 },
        "totalDocuments": { "type": "integer", "minimum": 0 },
        "headlinePrimaryCount": { "type": "integer", "minimum": 0 },
        "subnationalCount": { "type": "integer", "minimum": 0 },
        "bindingLawCount": { "type": "integer", "minimum": 0 },
        "supersessionChainCount": { "type": "integer", "minimum": 0 },
        "latestPublicationDate": { "type": "string" },
        "latestPublicationIso": { "type": ["string", "null"] }
      }
    }
  }
}
